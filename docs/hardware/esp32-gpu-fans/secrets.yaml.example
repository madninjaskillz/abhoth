# Copy to secrets.yaml next to gpu-fans.yaml (or merge into your ESPHome secrets.yaml) and fill in.
# Never commit the filled-in file.
wifi_ssid: "<your network>"
wifi_ssid_legacy: "<older name of the same network, or the same value>"
wifi_password: "<wifi password>"
fallback_password: "<password for the fallback access point>"
api_key: "<32-byte base64 ESPHome API encryption key>"
web_user: "<web_server user; the supervisor's fan backend uses it>"
web_password: "<web_server password; give it to the supervisor as a secret file>"
