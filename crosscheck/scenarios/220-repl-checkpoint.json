{
  "_comment": "Interactive: /checkpoint list, diff, restore (confirmed), clear after a write.",
  "files": {
    "a.txt": "old\n"
  },
  "replies": [
    {
      "tools": [
        {
          "name": "read_file",
          "args": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "write_file",
          "args": {
            "path": "a.txt",
            "content": "new\n"
          }
        }
      ]
    },
    {
      "text": "Rewrote a.txt. CP-DONE"
    }
  ],
  "interactive": {
    "cols": 100,
    "rows": 32,
    "steps": [
      {
        "action": "waitFor",
        "text": "❯",
        "timeoutMs": 45000
      },
      {
        "action": "waitQuiet",
        "ms": 500
      },
      {
        "action": "type",
        "text": "rewrite a.txt"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "CP-DONE",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/checkpoint list"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "Checkpointed At",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/checkpoint diff a.txt"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "Checkpoint Diff",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/checkpoint restore a.txt"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "from checkpoint?",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "key",
        "name": "enter",
        "count": 1
      },
      {
        "action": "waitFor",
        "text": "Restored:"
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/checkpoint clear"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "All checkpoints cleared",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/checkpoint list"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "No file checkpoints",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/checkpoint bogus"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "Usage: /checkpoint",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/exit"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "exit",
        "timeoutMs": 15000
      },
      {
        "action": "expect",
        "text": "Goodbye!"
      }
    ],
    "compareScreen": [
      "Goodbye!",
      "Restored:",
      "All checkpoints cleared",
      "No file checkpoints",
      "Usage: /checkpoint",
      "\\d+ bytes",
      "[-+](old|new)\\b"
    ]
  }
}
