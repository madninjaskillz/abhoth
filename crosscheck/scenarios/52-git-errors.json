{
  "prompt": "Try git and GitHub in a folder that is not a repository",
  "files": {
    "a.txt": "one\n"
  },
  "env": {
    "GIT_AUTHOR_NAME": "Test",
    "GIT_AUTHOR_EMAIL": "test@test.com",
    "GIT_COMMITTER_NAME": "Test",
    "GIT_COMMITTER_EMAIL": "test@test.com",
    "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
    "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
    "GIT_CONFIG_GLOBAL": "<HOME>/gitconfig",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "replies": [
    {
      "tools": [
        {
          "name": "git_status",
          "args": {}
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_log",
          "args": {
            "path": "missing"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_branch",
          "args": {
            "action": "rename"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "github",
          "args": {
            "action": "nonexistent"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "github",
          "args": {
            "action": "pr_view"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "github",
          "args": {
            "action": "pr_comment",
            "number": 1
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "github",
          "args": {
            "action": "pr_list",
            "path": "missing"
          }
        }
      ]
    },
    {
      "text": "This folder is not a git repository, and the GitHub calls were missing parameters."
    }
  ]
}
