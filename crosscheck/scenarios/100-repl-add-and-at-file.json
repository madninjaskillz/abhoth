{
  "_comment": "Interactive: /add notes.txt adds the file as a user message (no request); a prompt with @todo.md has the file inlined.",
  "files": {
    "notes.txt": "alpha\nbeta\n",
    "todo.md": "- buy milk\n- call Bob\n"
  },
  "replies": [
    {
      "text": "Read both. ADD-DONE"
    },
    {
      "text": "Todo seen. AT-DONE"
    }
  ],
  "interactive": {
    "cols": 100,
    "rows": 32,
    "steps": [
      {
        "action": "waitFor",
        "text": "❯",
        "timeoutMs": 45000
      },
      {
        "action": "waitQuiet",
        "ms": 500
      },
      {
        "action": "type",
        "text": "/add notes.txt"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "Added 1 file"
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/add missing.txt"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "No files matched"
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "what do you see?"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "ADD-DONE",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "summarise @todo.md please"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "AT-DONE",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/exit"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "exit",
        "timeoutMs": 15000
      },
      {
        "action": "expect",
        "text": "Goodbye!"
      }
    ],
    "compareScreen": [
      "Goodbye!",
      "Added 1 file(s) to context",
      "No files matched"
    ]
  }
}
