{
  "prompt": "Work with branches and the stash",
  "files": {
    "a.txt": "one\n",
    "notes.txt": "x\n"
  },
  "env": {
    "GIT_AUTHOR_NAME": "Test",
    "GIT_AUTHOR_EMAIL": "test@test.com",
    "GIT_COMMITTER_NAME": "Test",
    "GIT_COMMITTER_EMAIL": "test@test.com",
    "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
    "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
    "GIT_CONFIG_GLOBAL": "<HOME>/gitconfig",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "setup": [
    [
      "git",
      "init",
      "-b",
      "main"
    ],
    [
      "git",
      "add",
      "-A"
    ],
    [
      "git",
      "commit",
      "-m",
      "initial commit"
    ]
  ],
  "replies": [
    {
      "tools": [
        {
          "name": "git_branch",
          "args": {
            "action": "create",
            "name": "feature"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_branch",
          "args": {}
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_branch",
          "args": {
            "action": "create"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_checkout",
          "args": {
            "target": "feature"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_checkout",
          "args": {
            "target": "topic",
            "create": true
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_checkout",
          "args": {
            "target": "does-not-exist"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "read_file",
          "args": {
            "path": "notes.txt"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "write_file",
          "args": {
            "path": "notes.txt",
            "content": "changed\n"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_stash",
          "args": {
            "action": "push",
            "message": "wip notes"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_stash",
          "args": {
            "action": "list"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_stash",
          "args": {
            "action": "pop",
            "index": 0
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_diff",
          "args": {
            "staged": true
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_commit",
          "args": {
            "message": "notes",
            "files": [
              "notes.txt"
            ]
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_branch",
          "args": {
            "action": "delete",
            "name": "feature"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_stash",
          "args": {
            "action": "bogus"
          }
        }
      ]
    },
    {
      "text": "I created and switched branches, stashed and restored notes.txt, and committed it."
    }
  ]
}
