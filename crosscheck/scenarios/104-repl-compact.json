      },
      {
        "action": "type",
        "text": "first long question"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "C1-DONE",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "second question"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "C2-DONE",
        "timeoutMs": 30000
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "/compact"
      },
      {
        "action": "key",
        "name": "enter"
      },
      {
        "action": "waitFor",
        "text": "Compacted"
      },
      {
        "action": "waitQuiet",
        "ms": 600
      },
      {
        "action": "type",
        "text": "go on"
