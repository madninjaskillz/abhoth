{
  "prompt": "What is the first line of notes.txt? Use an explore agent.",
  "config": {
    "agent": {"leadMode": "hands-on"},
    "slots": {
      "copies": [
        { "name": "A", "baseUrl": "<SERVER>", "slots": 2 }
      ],
      "model": "copy-model",
      "localStateFile": "<HOME_JSON>/slots.json",
      "idleReleaseMinutes": 0
    }
  },
  "files": {"notes.txt": "alpha\nbeta\n"},
  "server_routes": {
    "GET /health": [200, "{\"status\":\"ok\",\"service\":\"strata\"}"],
    "GET /v1/models": [200, "{\"object\":\"list\",\"data\":[{\"id\":\"copy-model\",\"object\":\"model\",\"owned_by\":\"strata\"}]}"]
  },
  "replies": [
    {"tools": [{"name": "spawn_agent", "args": {"task": "Read notes.txt and report its first line.", "agent_type": "explore", "label": "Read notes"}}]},
    {"tools": [{"name": "read_file", "args": {"path": "notes.txt"}}]},
    {"text": "The first line of notes.txt is alpha."},
    {"text": "Agent A found that the first line is alpha."}
  ]
}
