{
  "prompt": "Write notes.txt saying hello.",
  "config": {
    "agent": {
      "reasoning": {
        "maxStepTokens": 100
      }
    }
  },
  "replies": [
    {
      "reasoning": "Plan: write notes.txt. ",
      "reasoning_chunk_chars": 16,
      "text": "never reached"
    },
    {
      "reasoning": "Short plan.",
      "tools": [
        {
          "name": "write_file",
          "args": {
            "path": "notes.txt",
            "content": "hello"
          }
        }
      ]
    },
    {
      "text": "Wrote notes.txt with the single word hello in it, as asked."
    }
  ]
}
