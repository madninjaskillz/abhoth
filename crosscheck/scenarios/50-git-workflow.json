{
  "prompt": "Change a.txt, add b.txt and commit",
  "files": {
    "a.txt": "one\n"
  },
  "env": {
    "GIT_AUTHOR_NAME": "Test",
    "GIT_AUTHOR_EMAIL": "test@test.com",
    "GIT_COMMITTER_NAME": "Test",
    "GIT_COMMITTER_EMAIL": "test@test.com",
    "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
    "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
    "GIT_CONFIG_GLOBAL": "<HOME>/gitconfig",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "setup": [
    [
      "git",
      "init",
      "-b",
      "main"
    ],
    [
      "git",
      "add",
      "-A"
    ],
    [
      "git",
      "commit",
      "-m",
      "initial commit"
    ]
  ],
  "replies": [
    {
      "tools": [
        {
          "name": "git_status",
          "args": {}
        }
      ]
    },
    {
      "tools": [
        {
          "name": "read_file",
          "args": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "edit_file",
          "args": {
            "path": "a.txt",
            "old_string": "one",
            "new_string": "two"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_diff",
          "args": {}
        }
      ]
    },
    {
      "tools": [
        {
          "name": "write_file",
          "args": {
            "path": "b.txt",
            "content": "new\n"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_status",
          "args": {
            "path": "."
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_commit",
          "args": {
            "message": "second commit"
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_log",
          "args": {}
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_log",
          "args": {
            "oneline": false,
            "count": 1
          }
        }
      ]
    },
    {
      "tools": [
        {
          "name": "git_diff",
          "args": {
            "base": "HEAD~1",
            "file": "a.txt"
          }
        }
      ]
    },
    {
      "text": "I changed a.txt, added b.txt and committed both as \"second commit\"."
    }
  ]
}
