{
  "$schema": "../../schema/abhoth-engine.schema.json",
  "schema": 1,
  "id": "chatterbox",
  "name": "Chatterbox TTS",
  "version": "0.1.7",
  "description": "Resemble AI Chatterbox text to speech, with voice cloning from reference clips.\nThe existing method runs a locally built image already on the host (Wyoming plus an HTTP API); the pip method runs the chatterbox-tts package behind a small OpenAI-speech server (server.py).",
  "kinds": ["tts"],
  "caps": { "inherits": "chatterbox" },
  "hardware": { "gpu": ["cuda"], "min_vram_gib": 3.5, "cpu_ok": true, "min_ram_gib": 6 },
  "params": {
    "voices_dir": { "type": "path", "default": "", "description": "A folder of reference voice clips (<name>.wav)." },
    "voice": { "type": "string", "default": "", "description": "The default voice (a clip name in voices_dir); empty for the built-in voice." }
  },
  "api": "openai-speech",
  "also_speaks": ["wyoming"],
  "probe": "http",
  "endpoints": { "health": "/health", "voices": "/voices" },
  "models": { "layout": "hf", "env": "HF_HOME", "mount": "/hf", "read_only": false },
  "methods": [
    {
      "type": "existing",
      "label": "local image (tts-nano)",
      "platforms": ["linux/amd64"],
      "gpu": ["cuda"],
      "detect": { "image": "local/tts-nano:1.3" },
      "env": { "CBS_HTTP_PORT": "10204", "CBS_PORT": "10203", "CBS_VOICES_DIR": "/data/voices", "CBS_VOICE": "{{param.voice}}", "HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1" },
      "ports": [ { "id": "http", "container": 10204 }, { "id": "wyoming", "container": 10203, "protocol": "tcp" } ],
      "health": { "http": "/health", "start_seconds": 300 }
    },
    {
      "type": "pip",
      "label": "pip (host)",
      "platforms": ["linux/amd64", "windows/amd64"],
      "gpu": ["cuda", "cpu"],
      "python": "3.11",
      "requirements": ["chatterbox-tts==0.1.7"],
      "files": ["server.py"],
      "run": ["{{python}}", "{{install}}/server.py", "--host", "{{host}}", "--port", "{{port}}", "--voices", "{{param.voices_dir}}", "--voice", "{{param.voice}}"],
      "ports": [ { "id": "http" } ],
      "health": { "http": "/health", "start_seconds": 900 }
    }
  ],
  "security": {
    "host_mounts": [
      { "source": "{{param.voices_dir}}", "target": "/data/voices", "read_only": true, "why": "the reference voice clips" }
    ]
  },
  "licence": "MIT",
  "source": "https://github.com/resemble-ai/chatterbox",
  "notes": ["The existing method needs the image built on the host beforehand; nothing is fetched or verified for it."]
}
