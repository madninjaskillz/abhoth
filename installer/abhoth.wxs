<!--
  Abhoth for Windows: a per-user MSI (WiX v5 authoring; PORTING.md D115). No admin rights.

  Installs abhoth.exe and abhoth-desktop.exe to %LOCALAPPDATA%\Programs\Abhoth, a Start-menu
  shortcut to abhoth-desktop.exe, and (unless ADDTOPATH=0) that folder on the user PATH.
  Uninstall from Settings > Apps, or `msiexec /x abhoth-<version>-x64.msi`. The state home
  (~/.abhoth) is never touched.

  Built by build.ps1:  wix build abhoth.wxs -arch x64 -d Version=... -d BinDir=... -d IconDir=...
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Abhoth"
           Manufacturer="Abhoth"
           Version="$(var.Version)"
           UpgradeCode="6f1d3c2a-5b7e-4e8a-9c41-0a7b2d9e3f15"
           Scope="perUser"
           Compressed="yes">
    <SummaryInformation Description="Abhoth: a coding agent for local models" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Abhoth is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AbhothIcon" SourceFile="$(var.IconDir)\abhoth.ico" />
    <Property Id="ARPPRODUCTICON" Value="AbhothIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Add the install folder to the user PATH; ADDTOPATH=0 on the msiexec line turns it off. -->
    <Property Id="ADDTOPATH" Value="1" Secure="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Abhoth" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components are keyed on HKCU values (ICE38); the folders go on uninstall when
         empty (ICE64). -->
    <Component Id="Binaries" Directory="INSTALLFOLDER" Guid="4b2e7f0c-1d6a-4c39-8e5b-7a0f3c9d2e61">
      <File Id="AbhothExe" Source="$(var.BinDir)\abhoth.exe" KeyPath="no" />
      <File Id="AbhothDesktopExe" Source="$(var.BinDir)\abhoth-desktop.exe" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\Abhoth" Name="InstallDir" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="9a7c1e45-3f2b-4d8e-b6a0-5c4e2f1d7b93">
      <Shortcut Id="AbhothDesktopShortcut"
                Name="Abhoth"
                Description="Abhoth desktop app"
                Target="[INSTALLFOLDER]abhoth-desktop.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AbhothIcon" />
      <RegistryValue Root="HKCU" Key="Software\Abhoth" Name="StartMenuShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <Component Id="UserPath" Directory="INSTALLFOLDER" Guid="2d8f4a19-6e3c-4b7a-a5d2-8c1b0e9f4a37"
               Condition="ADDTOPATH = &quot;1&quot;">
      <Environment Id="AbhothPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last"
                   Action="set" System="no" Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\Abhoth" Name="AddedToPath" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Abhoth" Level="1">
      <ComponentRef Id="Binaries" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UserPath" />
    </Feature>
  </Package>
</Wix>
